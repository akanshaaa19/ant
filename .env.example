# Supabase — needed for the "Save & share walk" feature.
# Get these from https://supabase.com/dashboard → your project → Settings → API.
# Without them, the share feature is hidden but everything else works.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Places API — only needed if you run `npm run sync-hours` (CLI script, not the app).
GOOGLE_PLACES_API_KEY=
